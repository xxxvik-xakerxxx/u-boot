bootdelay=3
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
serial#=tetris-uboot
board=nothing-tetris
platform=mt6878

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
scan_storage=scsi scan
fastboot=echo fastboot buffer located at 0x$fastboot_addr_r; fastboot -l $fastboot_addr_r usb 0

# For kernels compressed with gzip
kernel_comp_addr_r=0x52000000
kernel_comp_size=0x10000000
bootargs=clk_ignore_unused console=tty0 loglevel=7 earlycon=uart8250,mmio32,0x11001000 panic=-1 ignore_loglevel ramoops.mem_address=0x48090000 ramoops.mem_size=0xe0000 ramoops.record_size=0x20000 ramoops.console_size=0x20000

# Refresh before booting because MTK UFS can lose its partition list after
# fastboot/USB transitions. Do not scan before entering fastboot itself:
# fastboot must remain available even if UFS probing is unhappy.
normal_boot=run scan_storage; \
            ext4load scsi 2:51 0x49000000 /boot_image.itb; \
            bootm 0x49000000;                              \
            setcurs 0 3; lcdputs "Failed to do normal boot!"; \
            run menucmd;

# Keep this build in Fastboot by default. Boot postmarketOS with
# `fastboot oem board:boot_pmos`, from the menu, or from the shell.
bootcmd=run fastboot
boot_pmos=run normal_boot
menu=run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot postmarketOS=run normal_boot; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable USB mass storage=run scan_storage; echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_3=Enable fastboot mode=run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause
bootmenu_9=Dump bootargs=fdt print /chosen bootargs; pause

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
