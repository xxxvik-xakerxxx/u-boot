bootdelay=3
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
serial#=tetris-uboot
board=nothing-tetris
platform=mt6878

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
scan_storage=scsi scan
fastboot=echo fastboot buffer located at 0x$fastboot_addr_r; fastboot -l $fastboot_addr_r usb 0

# For kernels compressed with gzip
kernel_comp_addr_r=0x52000000
kernel_comp_size=0x10000000
bootargs_base=clk_ignore_unused console=tty0 loglevel=7 earlycon=uart8250,mmio32,0x11001000 panic=-1 ignore_loglevel ramoops.mem_address=0x48090000 ramoops.mem_size=0xe0000 ramoops.record_size=0x20000 ramoops.console_size=0x20000
bootargs_extra=
bootargs_safe=systemd.mask=nothing-tetris-connectivity.service systemd.mask=nothing-tetris-bluetooth-address.service module_blacklist=connadp,conninfra,connfem,wmtWifi,wlan_drv_gen4m_6878,bt_drv_6878,snd_soc_mt6369,snd_soc_mt6878_afe,mt6878_mt6369

# Refresh before booting because MTK UFS can lose its partition list after
# fastboot/USB transitions. Do not scan before entering fastboot itself:
# fastboot must remain available even if UFS probing is unhappy.
find_pmos_partitions=part number scsi 2 super pmos_boot_part && part number scsi 2 userdata pmos_root_part
set_pmos_bootargs=fsuuid scsi 2:${pmos_boot_part} pmos_boot_uuid && fsuuid scsi 2:${pmos_root_part} pmos_root_uuid && setenv bootargs ${bootargs_base} pmos.boot_uuid=${pmos_boot_uuid} pmos.root_uuid=${pmos_root_uuid} ${bootargs_extra}
load_connsys_bt=ext4load scsi 2:${pmos_root_part} 0x85e00000 /usr/lib/firmware/connsys_bt_mt6878_mt6631.bin 0xb4e5c && test ${filesize} = b4e5c
load_connsys_gnss=ext4load scsi 2:${pmos_root_part} 0x860e0000 /usr/lib/firmware/connsys_gnss_mt6878_mt6631.bin 0x7fc68 && test ${filesize} = 7fc68
load_connsys_wifi=ext4load scsi 2:${pmos_root_part} 0x86180000 /usr/lib/firmware/connsys_wifi_mt6878_mt6631.bin 0x174c24 && test ${filesize} = 174c24
load_boot_image=ext4load scsi 2:${pmos_boot_part} 0x49000000 /boot_image.itb
boot_pmos=run scan_storage && run find_pmos_partitions && run set_pmos_bootargs && run load_connsys_bt && run load_connsys_gnss && run load_connsys_wifi && run load_boot_image && bootm 0x49000000
boot_pmos_safe=setenv bootargs_extra ${bootargs_safe}; run boot_pmos; setenv bootargs_extra
normal_boot=if run boot_pmos; then true; else setcurs 0 3; lcdputs "Failed to boot postmarketOS!"; run menucmd; fi

# Keep this build in Fastboot by default. Boot postmarketOS with
# `fastboot oem board:boot_pmos`, from the menu, or from the shell.
bootcmd=run fastboot
menu=run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot postmarketOS=run normal_boot; pause
bootmenu_1=Boot postmarketOS (safe USB debug)=run boot_pmos_safe; pause
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Enable USB mass storage=run scan_storage; echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_4=Enable fastboot mode=run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_5=Drop to shell=setenv bootretry -1
bootmenu_6=Reset device=reset
bootmenu_7=Dump clocks=clk dump; pause
bootmenu_8=Dump environment=printenv; pause
bootmenu_9=Board info=bdinfo; pause
bootmenu_10=Dump bootargs=fdt print /chosen bootargs; pause

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
